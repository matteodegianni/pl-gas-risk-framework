{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "risk_overview_util_bar",
  "position": {
    "x": 780,
    "y": 130,
    "z": 5,
    "width": 480,
    "height": 330,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimLimit"
                    }
                  },
                  "Property": "limit_short"
                }
              },
              "queryRef": "DimLimit.limit_short",
              "nativeQueryRef": "limit_short",
              "displayName": "Limit"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactLimitUtilisation"
                    }
                  },
                  "Property": "Latest Utilisation"
                }
              },
              "queryRef": "FactLimitUtilisation.Latest Utilisation",
              "nativeQueryRef": "Latest Utilisation",
              "displayName": "Utilisation"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "FactLimitUtilisation"
                  }
                },
                "Property": "Latest Utilisation"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Limit utilisation today'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'Share of limit'"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'Limit'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
