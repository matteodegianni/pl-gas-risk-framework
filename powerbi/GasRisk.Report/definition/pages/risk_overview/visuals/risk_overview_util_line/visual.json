{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "risk_overview_util_line",
  "position": {
    "x": 20,
    "y": 470,
    "z": 6,
    "width": 820,
    "height": 240,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "DimDate.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactLimitUtilisation"
                    }
                  },
                  "Property": "Limit Utilisation %"
                }
              },
              "queryRef": "FactLimitUtilisation.Limit Utilisation %",
              "nativeQueryRef": "Limit Utilisation %",
              "displayName": "Utilisation"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimLimit"
                    }
                  },
                  "Property": "limit_name"
                }
              },
              "queryRef": "DimLimit.limit_name",
              "nativeQueryRef": "limit_name"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Utilisation history by limit'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'Share of limit'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
