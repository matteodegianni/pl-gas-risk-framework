table FactBacktest
	lineageTag: 7bf8bffb-b855-597c-8b93-9361e0b81eaa

	measure 'Observed Exceptions' = SUM ( FactBacktest[observed] )
		formatString: 0
		lineageTag: 6d9bccee-e5d2-5dd7-ad6c-e6961a8144d2

	measure 'Expected Exceptions' = SUM ( FactBacktest[expected] )
		formatString: 0.0
		lineageTag: a587e40b-9bc9-5c58-8c09-73d6dfedaa20

	measure 'Kupiec p' = AVERAGE ( FactBacktest[p_pof] )
		formatString: 0.0000
		lineageTag: 80638522-04c0-5318-a53d-feadace26e22

	measure 'Conditional Coverage p' = AVERAGE ( FactBacktest[p_cc] )
		formatString: 0.0000
		lineageTag: 4061f5cc-7e46-59ee-a2fb-540cefcf63a3

	measure 'Tests Passed' = COUNTROWS ( FILTER ( FactBacktest, FactBacktest[pass_cc] = TRUE () ) )
		formatString: 0
		lineageTag: 0cf1ae14-1c36-5545-ae63-af9d4402740b

	measure 'Kupiec Result' = IF ( COUNTROWS ( FILTER ( FactBacktest, FactBacktest[pass_pof] = FALSE () ) ) > 0, "fail", "pass" )
		lineageTag: 28f8566e-e29f-59a4-94cb-9e94738544e0

	measure 'Coverage Result' = IF ( COUNTROWS ( FILTER ( FactBacktest, FactBacktest[pass_cc] = FALSE () ) ) > 0, "fail", "pass" )
		lineageTag: 45cabca7-2549-52a7-a0b1-606d6b114122

