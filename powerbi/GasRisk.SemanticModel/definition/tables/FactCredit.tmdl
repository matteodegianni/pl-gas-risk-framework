table FactCredit
	lineageTag: 00322240-8f32-5332-8379-8c4e3dfe212f

	measure 'Current Exposure' = SUM ( FactCredit[ce_eur] )
		formatString: #,0
		lineageTag: 00e35af5-97c5-59d3-af2f-813c31600a8b

	measure 'Peak PFE 95' = SUM ( FactCredit[peak_pfe_95_eur] )
		formatString: #,0
		lineageTag: 90526b13-8a9b-5b42-802d-d1b9b501df91

	measure 'PFE Limit' = SUM ( FactCredit[pfe_limit_eur] )
		formatString: #,0
		lineageTag: 4cb80482-313f-5871-8fd2-3fbdea616e64

	measure 'Credit Limit Utilisation' = MAX ( FactCredit[utilisation] )
		formatString: 0.00
		lineageTag: e3962ace-95cf-58e6-86aa-9f4a27bcc5ef

	measure 'Counterparties In Breach' = COUNTROWS ( FILTER ( FactCredit, FactCredit[status] = "breach" ) )
