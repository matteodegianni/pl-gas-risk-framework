table FactLimitUtilisation
	lineageTag: dee0fa51-d04f-5885-aa40-4271790bc999

	measure 'Limit Utilisation %' = AVERAGE ( FactLimitUtilisation[utilisation] )
		formatString: 0.00%
		lineageTag: 5540d750-5f03-5945-92c2-2659b8f80ee2

	measure 'Latest Utilisation' =
			VAR d = CALCULATE ( MAX ( FactLimitUtilisation[date] ), ALL ( FactLimitUtilisation ), ALL ( DimDate ) )
			RETURN CALCULATE ( [Limit Utilisation %], ALL ( DimDate ), FactLimitUtilisation[date] = d )
		formatString: 0.00%
		lineageTag: b955d5d3-4d70-51bb-87ce-3c60a97949dc

	measure 'Breach Days' = SUM ( FactLimitUtilisation[breach] )
		formatString: 0
		lineageTag: 3d9c2c99-43ec-5d0a-934d-773fdc897d90

	measure 'Amber Days' = COUNTROWS ( FILTER ( FactLimitUtilisation, FactLimitUtilisation[status] = "amber" ) )
		formatString: 0
		lineageTag: 72313e32-c2b2-5b83-9238-2a9ca1535e6b

	measure 'Limits In Breach Today' =
			VAR d = CALCULATE ( MAX ( FactLimitUtilisation[date] ), ALL ( FactLimitUtilisation ), ALL ( DimDate ) )
			RETURN CALCULATE ( SUM ( FactLimitUtilisation[breach] ), ALL ( DimDate ), FactLimitUtilisation[date] = d )
		formatString: 0
		lineageTag: c49fa219-cfd5-5717-9ce5-9adc7de91867

