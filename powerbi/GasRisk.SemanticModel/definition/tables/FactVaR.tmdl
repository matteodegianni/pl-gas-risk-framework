table FactVaR
	lineageTag: 24fa4adc-ba65-536d-983a-bec46f34def3

	measure 'VaR 95' = AVERAGE ( FactVaR[var_95] )
		formatString: #,0
		lineageTag: 6681c3c7-35e3-59e9-8c7b-bd2254068d8d

	measure 'VaR 99' = AVERAGE ( FactVaR[var_99] )
		formatString: #,0
		lineageTag: c6b5fd95-5284-5845-a4bc-6aba339da09a

	measure 'ES 97.5' = AVERAGE ( FactVaR[es_97_5] )
		formatString: #,0
		lineageTag: ff288370-b7e6-5e4a-8676-b78dfa219d56

	measure 'Official VaR 99' = CALCULATE ( [VaR 99], DimMethod[is_official] = 1 )
		formatString: #,0
		lineageTag: c4d72f19-9435-5bd1-9bff-fcf682ed5f69

	measure 'Official ES 97.5' = CALCULATE ( [ES 97.5], DimMethod[is_official] = 1 )
		formatString: #,0
		lineageTag: 2fcc140e-c8cd-5d6a-9788-b5062d03ce5a

	measure 'Latest Official VaR 99' =
			VAR d = CALCULATE ( MAX ( FactVaR[date] ), ALL ( FactVaR ), ALL ( DimDate ) )
			RETURN CALCULATE ( [Official VaR 99], ALL ( DimDate ), FactVaR[date] = d )
		formatString: #,0
		lineageTag: f53263fa-fde6-5e7a-a543-18cc24e219b5

	measure 'VaR Limit' = CALCULATE ( MAX ( DimLimit[limit_value] ), DimLimit[limit_key] = "var_99" )
		formatString: #,0
		lineageTag: 3cf15e03-ed0e-5caa-be0b-f9a580bed4b5

	measure 'Realised P&L' = SUM ( FactVaR[realised_pnl_next_day] )
		formatString: #,0
		lineageTag: 314af7ca-c8ed-5da6-90c2-17113f54d2d0

	measure 'Official VaR 99 Loss Threshold' = - [Official VaR 99]
		formatString: #,0
		lineageTag: 7c93dd9c-1536-5225-bab3-b94a9a4f147f

	measure 'Exceptions 95' = SUM ( FactVaR[exception_95] )
		formatString: 0
		lineageTag: d064e667-eda3-5767-8a7e-327bc73cc0b5

	measure 'Exceptions 99' = SUM ( FactVaR[exception_99] )
		formatString: 0
		lineageTag: 2c217f7e-9160-5708-bf1b-6b16c6de99ae

	measure 'Expected Exceptions 99' = COUNT ( FactVaR[realised_pnl_next_day] ) * 0.01
		formatString: 0.0
		lineageTag: 97f378a7-c8ed-5dc8-bba9-2bc092146129

	measure 'Exception Rate 99' = DIVIDE ( [Exceptions 99], COUNT ( FactVaR[realised_pnl_next_day] ) )
		formatString: 0.00%
		lineageTag: a8120726-74bc-5393-b4a4-319e124122b8

	measure 'Data Label' = "Synthetic book on real market data"
		lineageTag: 47c4a2cf-1126-5f74-bc8a-d3f1e685b0e1

